{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Install Prettier & ESLint Config",
      "type": "shell",
      "command": "npm install --save-dev prettier eslint-config-prettier eslint-plugin-prettier",
      "group": "build",
      "presentation": {
        "reveal": "always",
        "panel": "new"
      },
      "problemMatcher": []
    },
    {
      "label": "Format All Files",
      "type": "shell",
      "command": "npx prettier --write \"src/**/*.{ts,tsx,js,jsx,json,css,scss}\"",
      "group": "build",
      "presentation": {
        "reveal": "always",
        "panel": "new"
      },
      "problemMatcher": []
    },
    {
      "label": "Lint Fix All",
      "type": "shell",
      "command": "npm run lint -- --fix",
      "group": "test",
      "presentation": {
        "reveal": "always",
        "panel": "new"
      },
      "problemMatcher": []
    }
  ]
}
