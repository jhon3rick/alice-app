{
  "compilerOptions": {
    "target": "ES6",
    "allowJs": true,
    "module": "commonjs",
    "skipLibCheck": true,
    "esModuleInterop": true,
    "noImplicitAny": true,
    "sourceMap": true,
    "baseUrl": ".",
    "outDir": "dist",
    "moduleResolution": "node",
    "resolveJsonModule": true,
    "jsx": "react",
    "lib": ["ES6", "DOM", "DOM.Iterable"],
    "paths": {
      "@/*": ["src/*"],
      "@main/*": ["src/main/*"],
      "@renderer/*": ["src/renderer/*"],
      "@presentation/*": ["src/renderer/presentation/*"],
      "@components/*": ["src/renderer/presentation/components/*"],
      "@contexts/*": ["src/renderer/presentation/contexts/*"],
      "@views/*": ["src/renderer/presentation/views/*"],
      "@store/*": ["src/renderer/presentation/store/*"],
      "@tstypes/*": ["src/renderer/presentation/tstypes/*"],
      "@utils/*": ["src/renderer/presentation/utils/*"],
      "@const/*": ["src/renderer/presentation/const/*"],
      "@ui/*": ["src/renderer/presentation/ui/*"],
      "@styles/*": ["src/renderer/presentation/styles/*"],
      "@assets/*": ["src/renderer/presentation/assets/*"],
      "*": ["node_modules/*"]
    }
  },
  "include": ["src/**/*"]
}
